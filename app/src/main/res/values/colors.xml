<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =========================================================
         MONEFLO LIGHT THEME — token dari design_system_2 (Stitch)
         ========================================================= -->

    <!-- ===== SURFACE / BACKGROUND ===== -->
    <color name="background">#F9F9FF</color>
    <color name="surface">#F9F9FF</color>
    <color name="surface_container_lowest">#FFFFFF</color>
    <color name="surface_container_low">#F0F3FF</color>
    <color name="surface_container">#E7EEFE</color>
    <color name="surface_container_high">#E2E8F8</color>
    <color name="surface_container_highest">#DCE2F3</color>

    <!-- ===== TEXT / ON-SURFACE ===== -->
    <color name="on_surface">#151C27</color>
    <color name="on_surface_variant">#454651</color>
    <color name="outline">#767682</color>
    <color name="outline_variant">#C6C5D3</color>

    <!-- ===== BRAND ===== -->
    <color name="primary">#142175</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#2E3A8C</color>
    <color name="on_primary_container">#9EA9FF</color>
    <color name="secondary">#10B981</color>
    <color name="on_secondary">#FFFFFF</color>
    <color name="secondary_container">#6CF8BB</color>

    <!-- ===== STATUS ===== -->
    <color name="error">#BA1A1A</color>
    <color name="income">#10B981</color>
    <color name="expense">#DC2626</color>

    <!-- ===== INPUT ===== -->
    <color name="input_field_bg">#F3F4F6</color>

    <!-- ===== ICON CIRCLE GLOW (dipakai logo_glow_bg) ===== -->
    <color name="icon_bg_start">#33142175</color>
    <color name="icon_bg_end">#00142175</color>
    <color name="icon_bg_stroke">#4D142175</color>

    <!-- Teks di atas kartu "Total Saldo" (gradient_start/gradient_end) —
         kartu tetap indigo pekat di light mode, jadi teks harus tetap putih. -->
    <color name="on_gradient_primary">#FFFFFF</color>
    <color name="on_gradient_primary_variant">#CCFFFFFF</color>

    <!-- =========================================================
         LEGACY ALIASES — supaya layout lama tetap jalan & otomatis
         ikut berganti warna saat tema berubah (lihat values-night/colors.xml)
         ========================================================= -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="black">#FF000000</color>

    <color name="bg_dark">@color/background</color>
    <color name="card_bg">@color/surface_container_low</color>
    <color name="input_bg">@color/input_field_bg</color>
    <color name="social_btn_bg">@color/surface_container_lowest</color>

    <color name="text_primary">@color/on_surface</color>
    <color name="text_secondary">@color/on_surface_variant</color>
    <color name="text_hint">@color/outline</color>

    <color name="cyan_accent">@color/primary</color>
    <color name="blue_accent">@color/primary_container</color>
    <color name="cyan_ripple">#20142175</color>

    <color name="input_stroke">@color/outline_variant</color>
    <color name="input_stroke_focused">@color/primary</color>
    <color name="divider_color">@color/outline_variant</color>
    <color name="card_border">@color/outline_variant</color>

    <color name="error_red">@color/error</color>
    <color name="success_green">@color/income</color>
    <color name="income_green">@color/income</color>
    <color name="expense_red">@color/expense</color>

    <color name="gradient_start">@color/primary</color>
    <color name="gradient_end">@color/primary_container</color>

    <color name="income_tint_bg">#1A10B981</color>
    <color name="expense_tint_bg">#1ADC2626</color>

    <!-- Pill segmen terpilih (Week/Month/Year) — light: kartu putih mengambang,
         dark: warna primary supaya tetap menonjol di atas track gelap. -->
    <color name="segment_selected_bg">@color/surface_container_lowest</color>
    <color name="segment_selected_text">@color/on_surface</color>

</resources>
