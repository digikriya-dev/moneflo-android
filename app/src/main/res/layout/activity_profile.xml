<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Profil"
            app:titleTextColor="@color/text_primary"
            app:titleTextAppearance="@style/ToolbarTitleStyle" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="120dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_screen_padding"
            android:paddingEnd="@dimen/spacing_screen_padding"
            android:paddingTop="8dp">

            <!-- AVATAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="@dimen/spacing_screen_padding"
                android:paddingBottom="@dimen/spacing_section_gap">

                <FrameLayout
                    android:id="@+id/btn_change_photo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginBottom="@dimen/spacing_gap"
                    android:clickable="true"
                    android:focusable="true">
                    <View
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_avatar_circle" />
                    <TextView
                        android:id="@+id/tv_avatar_initial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/on_gradient_primary"
                        android:textSize="32sp"
                        android:fontFamily="@font/poppins_bold" />
                    <ImageView
                        android:id="@+id/iv_avatar_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:scaleType="centerCrop" />
                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_circle_solid"
                        android:backgroundTint="@color/primary" />
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="6dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/on_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_nama_lengkap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Moneflo.H2"
                    android:layout_marginBottom="@dimen/spacing_unit" />

                <TextView
                    android:id="@+id/tv_username_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cyan_accent"
                    android:textAppearance="@style/TextAppearance.Moneflo.Caption" />
            </LinearLayout>

            <!-- INFO CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_screen_padding"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_screen_padding"
                    android:background="@drawable/card_stroke_border">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informasi Akun"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginBottom="@dimen/spacing_gap" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username"
                        android:textColor="@color/text_hint"
                        android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tv_info_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.Moneflo.Body"
                        android:layout_marginBottom="@dimen/spacing_gap" />

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider_color" android:layout_marginBottom="@dimen/spacing_gap" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textColor="@color/text_hint"
                        android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tv_info_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.Moneflo.Body"
                        android:layout_marginBottom="@dimen/spacing_gap" />

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider_color" android:layout_marginBottom="@dimen/spacing_gap" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terdaftar Sejak"
                        android:textColor="@color/text_hint"
                        android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                        android:layout_marginBottom="2dp" />
                    <TextView
                        android:id="@+id/tv_info_tanggal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.Moneflo.Body" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TOMBOL AKSI -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_screen_padding"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_stroke_border">

                    <LinearLayout
                        android:id="@+id/btn_edit_profil"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/cyan_accent"
                            android:layout_marginEnd="14dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Edit Profil"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_back"
                            android:rotation="180"
                            app:tint="@color/text_hint" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider_color" />

                    <LinearLayout
                        android:id="@+id/btn_ubah_password"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/cyan_accent"
                            android:layout_marginEnd="14dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ubah Password"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_back"
                            android:rotation="180"
                            app:tint="@color/text_hint" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PREFERENSI TAMPILAN (TEMA) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_screen_padding"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_screen_padding"
                    android:background="@drawable/card_stroke_border">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preferensi Tampilan"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginBottom="@dimen/spacing_gap" />

                    <LinearLayout
                        android:id="@+id/theme_selector"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_segment_container"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/opt_theme_light"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Terang"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                            android:fontFamily="@font/poppins_medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/opt_theme_dark"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Gelap"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                            android:fontFamily="@font/poppins_medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/opt_theme_system"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Sistem"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                            android:fontFamily="@font/poppins_medium"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- LOGOUT -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">
                <LinearLayout
                    android:id="@+id/btn_logout"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/card_stroke_border">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/expense_red"
                        android:layout_marginEnd="14dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Logout"
                        android:textColor="@color/expense_red"
                        android:textAppearance="@style/TextAppearance.Moneflo.Body" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/component_bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:itemIconSize="@dimen/component_bottom_nav_icon_size"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="12dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>