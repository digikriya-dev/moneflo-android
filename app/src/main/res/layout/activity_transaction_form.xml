<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".TransactionFormActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="32dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_screen_padding"
            android:paddingEnd="@dimen/spacing_screen_padding"
            android:paddingTop="8dp">

            <!-- CARD FORM -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_section_gap"
                    android:background="@drawable/card_stroke_border">

                    <!-- Nama Transaksi -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_nama_transaksi"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxCornerRadiusTopStart="@dimen/radius_button"
                        app:boxCornerRadiusTopEnd="@dimen/radius_button"
                        app:boxCornerRadiusBottomStart="@dimen/radius_button"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                        app:hintTextColor="@color/text_hint"
                        app:errorTextColor="@color/error_red"
                        android:hint="Nama Transaksi">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_nama_transaksi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:paddingTop="@dimen/spacing_screen_padding"
                            android:paddingBottom="@dimen/spacing_screen_padding" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Jenis Transaksi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jenis Transaksi"
                        android:textColor="@color/text_hint"
                        android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rg_jenis_transaksi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <RadioButton
                            android:id="@+id/rb_pemasukan"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Pemasukan"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:buttonTint="@color/income_green"
                            android:background="@drawable/rb_income_bg"
                            android:layout_marginEnd="6dp" />

                        <RadioButton
                            android:id="@+id/rb_pengeluaran"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Pengeluaran"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:buttonTint="@color/expense_red"
                            android:background="@drawable/rb_expense_bg"
                            android:layout_marginStart="6dp" />
                    </RadioGroup>

                    <!-- Nominal -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_nominal"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxCornerRadiusTopStart="@dimen/radius_button"
                        app:boxCornerRadiusTopEnd="@dimen/radius_button"
                        app:boxCornerRadiusBottomStart="@dimen/radius_button"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                        app:hintTextColor="@color/text_hint"
                        app:errorTextColor="@color/error_red"
                        app:prefixText="Rp "
                        app:prefixTextColor="@color/text_secondary"
                        android:hint="Nominal">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_nominal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:paddingTop="@dimen/spacing_screen_padding"
                            android:paddingBottom="@dimen/spacing_screen_padding" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Kategori Spinner -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kategori"
                        android:textColor="@color/text_hint"
                        android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                        android:layout_marginBottom="8dp" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardBackgroundColor="@color/input_bg"
                        app:cardCornerRadius="@dimen/radius_button"
                        app:cardElevation="0dp">

                        <Spinner
                            android:id="@+id/spinner_kategori"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:background="@android:color/transparent" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tv_error_kategori"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/error_red"
                        android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                        android:visibility="gone"
                        android:layout_marginTop="-10dp"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="14dp" />

                    <!-- Tanggal -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_tanggal"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxCornerRadiusTopStart="@dimen/radius_button"
                        app:boxCornerRadiusTopEnd="@dimen/radius_button"
                        app:boxCornerRadiusBottomStart="@dimen/radius_button"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                        app:hintTextColor="@color/text_hint"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_email"
                        app:endIconTint="@color/text_hint"
                        android:hint="Tanggal">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_tanggal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:paddingTop="@dimen/spacing_screen_padding"
                            android:paddingBottom="@dimen/spacing_screen_padding" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Waktu -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_waktu"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxCornerRadiusTopStart="@dimen/radius_button"
                        app:boxCornerRadiusTopEnd="@dimen/radius_button"
                        app:boxCornerRadiusBottomStart="@dimen/radius_button"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                        app:hintTextColor="@color/text_hint"
                        android:hint="Waktu (opsional)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_waktu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:paddingTop="@dimen/spacing_screen_padding"
                            android:paddingBottom="@dimen/spacing_screen_padding" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Catatan -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_catatan"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxCornerRadiusTopStart="@dimen/radius_button"
                        app:boxCornerRadiusTopEnd="@dimen/radius_button"
                        app:boxCornerRadiusBottomStart="@dimen/radius_button"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                        app:hintTextColor="@color/text_hint"
                        android:hint="Catatan (opsional)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_catatan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3"
                            android:gravity="top"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:paddingTop="@dimen/spacing_screen_padding"
                            android:paddingBottom="@dimen/spacing_screen_padding" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Tombol Simpan -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_simpan"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/component_button_height"
                        android:text="Simpan"
                        android:textColor="@color/on_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"
                        android:background="@drawable/btn_gradient_primary"
                        app:cornerRadius="@dimen/radius_button"
                        app:rippleColor="#40FFFFFF"
                        app:elevation="0dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
