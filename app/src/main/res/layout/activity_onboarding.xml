<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    tools:context=".OnboardingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_screen_padding"
        android:paddingEnd="@dimen/spacing_screen_padding"
        android:paddingBottom="24dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Moneflo"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:id="@+id/tv_bantuan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bantuan"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Moneflo.Body"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- HERO ILLUSTRATION -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginBottom="28dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_saldo_bg" />

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center">
                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/logo_glow_bg" />
                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_logo"
                    app:tint="@color/on_gradient_primary" />
            </FrameLayout>

            <!-- Chip mengambang: Tabungan -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="@dimen/radius_button"
                app:cardElevation="6dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈"
                        android:textSize="16sp"
                        android:layout_marginEnd="8dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tabungan"
                            android:textColor="@color/on_surface"
                            android:textSize="10sp"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+12.5%"
                            android:textColor="@color/income"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Chip mengambang: Saldo Aman -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="@dimen/radius_button"
                app:cardElevation="6dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="16sp"
                        android:layout_marginEnd="8dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Saldo Aman"
                            android:textColor="@color/on_surface"
                            android:textSize="10sp"
                            android:fontFamily="@font/poppins_regular" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terenkripsi"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins_bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </FrameLayout>

        <!-- HEADLINE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kelola Keuangan dengan Elegan"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Moneflo.H1"
            android:textSize="26sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nikmati kontrol penuh atas keuanganmu dengan antarmuka yang tenang, cerdas, dan dirancang untuk ketenangan pikiran."
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Moneflo.Body"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <!-- TOMBOL -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mulai"
            android:layout_width="match_parent"
            android:layout_height="@dimen/component_button_height"
            android:text="Mulai Sekarang"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:background="@drawable/btn_gradient_primary"
            app:cornerRadius="@dimen/radius_button"
            app:rippleColor="#40FFFFFF"
            app:elevation="0dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_masuk"
            android:layout_width="match_parent"
            android:layout_height="@dimen/component_button_height"
            android:text="Masuk ke Akun"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Moneflo.Body"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/social_btn_bg"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="@color/input_stroke"
            app:strokeWidth="1dp"
            app:rippleColor="@color/cyan_ripple"
            app:elevation="0dp"
            android:layout_marginBottom="28dp" />

        <!-- FEATURE CHIPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/radius_button"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/card_stroke_border">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="20sp"
                        android:layout_marginBottom="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keamanan Berlapis"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/radius_button"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/card_stroke_border">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊"
                        android:textSize="20sp"
                        android:layout_marginBottom="6dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Analisis Cerdas"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
