<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".LoginActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="56dp"
            android:paddingBottom="40dp">

            <!-- LOGO -->
            <LinearLayout
                android:id="@+id/logo_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="36dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp">
                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/logo_glow_bg" />
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_logo"
                        app:tint="@color/cyan_accent" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONEFLO"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:fontFamily="@font/poppins_bold"
                    android:letterSpacing="0.12" />
            </LinearLayout>

            <!-- FORM CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/form_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_section_gap"
                    android:background="@drawable/card_stroke_border">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selamat Datang!"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.Moneflo.H2"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="@dimen/spacing_unit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Masuk untuk melanjutkan"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Moneflo.Body"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="28dp" />

                    <!-- Username -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_username"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_screen_padding"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxCornerRadiusTopStart="@dimen/radius_button"
                        app:boxCornerRadiusTopEnd="@dimen/radius_button"
                        app:boxCornerRadiusBottomStart="@dimen/radius_button"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                        app:hintTextColor="@color/text_hint"
                        app:errorTextColor="@color/error_red"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/cyan_accent"
                        android:hint="Username">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textNoSuggestions"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:paddingTop="@dimen/spacing_screen_padding"
                            android:paddingBottom="@dimen/spacing_screen_padding" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_gap"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxCornerRadiusTopStart="@dimen/radius_button"
                        app:boxCornerRadiusTopEnd="@dimen/radius_button"
                        app:boxCornerRadiusBottomStart="@dimen/radius_button"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                        app:hintTextColor="@color/text_hint"
                        app:errorTextColor="@color/error_red"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/cyan_accent"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/text_hint"
                        android:hint="Password">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:paddingTop="@dimen/spacing_screen_padding"
                            android:paddingBottom="@dimen/spacing_screen_padding" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Tetap Login + Lupa Password -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_section_gap">

                        <CheckBox
                            android:id="@+id/cb_remember_me"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tetap Login"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                            android:buttonTint="@color/cyan_accent"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_forgot_password"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lupa Password?"
                            android:textColor="@color/cyan_accent"
                            android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Tombol Login -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/component_button_height"
                        android:layout_marginBottom="@dimen/spacing_screen_padding">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sign_in"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Masuk"
                            android:textColor="@color/on_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:stateListAnimator="@null"
                            android:background="@drawable/btn_gradient_primary"
                            app:cornerRadius="@dimen/radius_button"
                            app:rippleColor="#40FFFFFF"
                            app:elevation="0dp" />

                        <ProgressBar
                            android:id="@+id/progress_bar"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/text_primary"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Divider OR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_screen_padding">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/divider_color" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  atau  "
                            android:textColor="@color/text_hint"
                            android:textAppearance="@style/TextAppearance.Moneflo.Caption" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/divider_color" />
                    </LinearLayout>

                    <!-- Tombol Google -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_google"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Masuk dengan Google"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.Moneflo.Body"
                        android:stateListAnimator="@null"
                        android:layout_marginBottom="@dimen/spacing_section_gap"
                        app:backgroundTint="@color/social_btn_bg"
                        app:cornerRadius="@dimen/radius_button"
                        app:strokeColor="@color/input_stroke"
                        app:strokeWidth="1dp"
                        app:icon="@drawable/ic_google"
                        app:iconTint="@null"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:rippleColor="@color/cyan_ripple"
                        app:elevation="0dp" />

                    <!-- Link Daftar -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Belum punya akun? "
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body" />

                        <TextView
                            android:id="@+id/tv_sign_up"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daftar Pengguna"
                            android:textColor="@color/cyan_accent"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:fontFamily="@font/poppins_bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>