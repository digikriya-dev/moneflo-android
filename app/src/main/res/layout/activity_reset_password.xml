<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".ResetPasswordActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="80dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set Ulang Password"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Moneflo.H2"
                android:layout_marginBottom="@dimen/spacing_unit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buat password baru untuk akunmu"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                android:layout_marginBottom="32dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_section_gap"
                    android:background="@drawable/card_stroke_border">

                    <!-- Password Baru -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password_baru"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxCornerRadiusTopStart="@dimen/radius_button"
                        app:boxCornerRadiusTopEnd="@dimen/radius_button"
                        app:boxCornerRadiusBottomStart="@dimen/radius_button"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                        app:hintTextColor="@color/text_hint"
                        app:errorTextColor="@color/error_red"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/cyan_accent"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/text_hint"
                        android:hint="Password Baru">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password_baru"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:paddingTop="@dimen/spacing_screen_padding"
                            android:paddingBottom="@dimen/spacing_screen_padding" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Konfirmasi Password Baru -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_konfirmasi_password"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxCornerRadiusTopStart="@dimen/radius_button"
                        app:boxCornerRadiusTopEnd="@dimen/radius_button"
                        app:boxCornerRadiusBottomStart="@dimen/radius_button"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                        app:hintTextColor="@color/text_hint"
                        app:errorTextColor="@color/error_red"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/cyan_accent"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/text_hint"
                        android:hint="Konfirmasi Password Baru">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_konfirmasi_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.Moneflo.Body"
                            android:paddingTop="@dimen/spacing_screen_padding"
                            android:paddingBottom="@dimen/spacing_screen_padding" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Tombol Simpan -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_simpan"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/component_button_height"
                        android:text="Simpan"
                        android:textColor="@color/on_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"
                        android:background="@drawable/btn_gradient_primary"
                        app:cornerRadius="@dimen/radius_button"
                        app:rippleColor="#40FFFFFF"
                        app:elevation="0dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
