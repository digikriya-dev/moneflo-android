<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".DashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_dark">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/spacing_screen_padding"
            android:paddingEnd="@dimen/spacing_screen_padding"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <!-- Avatar + greeting kiri -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/btn_avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true">
                    <View
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/logo_glow_bg" />
                    <TextView
                        android:id="@+id/tv_avatar_initial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/cyan_accent"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_bold" />
                    <ImageView
                        android:id="@+id/iv_avatar_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_bold" />
            </LinearLayout>

            <!-- Notifikasi kanan -->
            <ImageView
                android:id="@+id/btn_bell"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_bell"
                android:background="@drawable/logo_glow_bg"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- MAIN CONTENT -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/root_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="100dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_screen_padding"
                android:paddingEnd="@dimen/spacing_screen_padding"
                android:paddingTop="8dp">

            <!-- KARTU SALDO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/card_saldo_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saldo Saat Ini"
                        android:textColor="@color/on_gradient_primary_variant"
                        android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                        android:layout_marginBottom="@dimen/spacing_unit" />

                    <TextView
                        android:id="@+id/tv_saldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp0"
                        android:textColor="@color/on_gradient_primary"
                        android:textAppearance="@style/TextAppearance.Moneflo.H1"
                        android:layout_marginBottom="20dp" />

                    <!-- Income & Expense row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Total Pemasukan -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▲ Pemasukan"
                                android:textColor="@color/income_green"
                                android:textAppearance="@style/TextAppearance.Moneflo.Caption" />

                            <TextView
                                android:id="@+id/tv_total_income"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp0"
                                android:textColor="@color/income_green"
                                android:textAppearance="@style/TextAppearance.Moneflo.Body"
                                android:fontFamily="@font/poppins_bold" />
                        </LinearLayout>

                        <!-- Divider vertikal -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/divider_color"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp" />

                        <!-- Total Pengeluaran -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▼ Pengeluaran"
                                android:textColor="@color/expense_red"
                                android:textAppearance="@style/TextAppearance.Moneflo.Caption" />

                            <TextView
                                android:id="@+id/tv_total_expense"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp0"
                                android:textColor="@color/expense_red"
                                android:textAppearance="@style/TextAppearance.Moneflo.Body"
                                android:fontFamily="@font/poppins_bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- GRAFIK PIE CHART -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_screen_padding"
                    android:background="@drawable/card_stroke_border">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pengeluaran Bulan Ini"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.Moneflo.Body"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginBottom="@dimen/spacing_gap" />

                    <!-- Pie Chart dari MPAndroidChart -->
                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pie_chart"
                        android:layout_width="match_parent"
                        android:layout_height="220dp" />

                    <!-- Empty state chart -->
                    <TextView
                        android:id="@+id/tv_chart_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Belum ada data untuk ditampilkan."
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                        android:layout_gravity="center_horizontal"
                        android:visibility="gone"
                        android:paddingTop="24dp"
                        android:paddingBottom="24dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- RECENT ACTIVITY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_gap">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Transaksi Terbaru"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.Moneflo.Body"
                        android:fontFamily="@font/poppins_bold" />

                    <TextView
                        android:id="@+id/tv_lihat_semua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lihat Semua"
                        android:textColor="@color/cyan_accent"
                        android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                        android:fontFamily="@font/poppins_medium"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- List transaksi terbaru -->
                <LinearLayout
                    android:id="@+id/ll_recent_transactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/ll_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_history"
                        android:alpha="0.4"
                        android:layout_marginBottom="@dimen/spacing_gap" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Belum ada transaksi."
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Moneflo.Body"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginBottom="@dimen/spacing_unit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tekan tombol + untuk menambahkan\ntransaksi pertama."
                        android:textColor="@color/text_hint"
                        android:textAppearance="@style/TextAppearance.Moneflo.Caption"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/component_bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:itemIconSize="@dimen/component_bottom_nav_icon_size"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="12dp" />

    <!-- FAB -->
    <FrameLayout
        android:layout_width="@dimen/component_fab_glow_size"
        android:layout_height="@dimen/component_fab_glow_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/spacing_screen_padding"
        android:layout_marginBottom="@dimen/spacing_fab_bottom_margin">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fab_glow_bg" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="@dimen/component_fab_size"
            android:layout_height="@dimen/component_fab_size"
            android:layout_gravity="center"
            android:src="@drawable/ic_add"
            android:contentDescription="Tambah Transaksi"
            app:backgroundTint="@color/cyan_accent"
            app:tint="@color/bg_dark"
            app:fabCustomSize="@dimen/component_fab_size"
            app:maxImageSize="28dp"
            app:elevation="8dp"
            app:pressedTranslationZ="12dp"
            app:rippleColor="@color/cyan_ripple" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
