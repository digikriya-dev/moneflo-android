<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer cyan glow border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1500D4E8" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#2500D4E8" />
        </shape>
    </item>
    <!-- Inner fill -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#161B22" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>